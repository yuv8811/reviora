{{ 'reviora-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'reviora-widget.js' | asset_url }}" defer="defer"></script>
<script>
  window.__REVIORA_APP_EMBED_ENABLED__ = true;
  document.documentElement.classList.add('reviora-embed-active');
  if (document.body) document.body.classList.add('reviora-embed-active');
</script>
<style>
  .reviora-app-block,
  reviora-reviews-carousel {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
  }
</style>

<div class="page-width reviora-app-block" style="width: 100%; max-width: 1200px; margin: {{ block.settings.margin_top | default: 40 }}px auto {{ block.settings.margin_bottom | default: 40 }}px auto; padding: 0 16px; box-sizing: border-box;">
  {% assign target_product_id = "all" %}
  {% if block.settings.product != blank and block.settings.product.handle != blank %}
    {% assign target_product_id = block.settings.product.handle %}
  {% elsif product != blank and product.handle != blank %}
    {% assign target_product_id = product.handle %}
  {% elsif block.settings.product != blank and block.settings.product.id != blank %}
    {% assign target_product_id = block.settings.product.id %}
  {% elsif product != blank and product.id != blank %}
    {% assign target_product_id = product.id %}
  {% endif %}

  <reviora-reviews-carousel
    type="testimonials"
    data-shop="{{ shop.myshopify_domain | default: shop.domain }}"
    data-product-id="{{ target_product_id }}"
    data-product-title="{{ product.title | default: 'Products' | escape }}"
    data-heading="{{ block.settings.heading | escape }}"
    data-subheading="{{ block.settings.subheading | escape }}"
    data-star-color="{{ block.settings.star_color | default: '#FFB800' }}"
    data-limit="{{ block.settings.limit | default: 6 }}"
    data-autoplay="{{ block.settings.autoplay | default: true }}"
  ></reviora-reviews-carousel>
</div>

{% schema %}
{
  "name": "Reviora Testimonials",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Are Saying"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Trusted by shoppers around the world"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Filter by Specific Product",
      "info": "Leave blank to display top reviews from your entire store"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Rating Color",
      "default": "#FFB800"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Max Testimonials to Show",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Auto-scroll",
      "default": true
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top Margin",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom Margin",
      "default": 40
    }
  ]
}
{% endschema %}
