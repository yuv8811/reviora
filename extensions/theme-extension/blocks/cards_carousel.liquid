{{ 'reviora-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'reviora-widget.js' | asset_url }}" defer="defer"></script>

<style>
  .reviora-carousel-track-wrap {
    position: relative !important;
    overflow: visible !important;
    padding: 14px 64px 24px 64px !important;
    box-sizing: border-box !important;
  }
  .reviora-carousel-track {
    display: flex !important;
    gap: 20px !important;
    overflow-x: auto !important;
    scroll-behavior: smooth !important;
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
    padding: 8px 4px 12px 4px !important;
  }
  .reviora-carousel-track::-webkit-scrollbar {
    display: none !important;
  }
  .reviora-carousel-nav-btn {
    position: absolute !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    width: 44px !important;
    height: 44px !important;
    border-radius: 50% !important;
    background: #ffffff !important;
    border: 1px solid #e2e8f0 !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12), 0 2px 4px rgba(0, 0, 0, 0.06) !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #0f172a !important;
    cursor: pointer !important;
    z-index: 9999 !important;
    pointer-events: auto !important;
    padding: 0 !important;
    outline: none !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
  .reviora-carousel-nav-btn:hover {
    background: #0f172a !important;
    color: #ffffff !important;
    border-color: #0f172a !important;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.24) !important;
    transform: translateY(-50%) scale(1.08) !important;
  }
  .reviora-carousel-nav-btn:active {
    transform: translateY(-50%) scale(0.96) !important;
  }
  .reviora-carousel-nav-btn svg {
    width: 20px !important;
    height: 20px !important;
    display: block !important;
    stroke: currentColor !important;
    stroke-width: 2.5 !important;
    pointer-events: none !important;
  }
  .reviora-carousel-prev {
    left: 8px !important;
  }
  .reviora-carousel-next {
    right: 8px !important;
  }
  @media (max-width: 640px) {
    .reviora-carousel-track-wrap {
      padding: 10px 48px 20px 48px !important;
    }
    .reviora-carousel-nav-btn {
      width: 36px !important;
      height: 36px !important;
    }
    .reviora-carousel-nav-btn svg {
      width: 16px !important;
      height: 16px !important;
    }
    .reviora-carousel-prev {
      left: 4px !important;
    }
    .reviora-carousel-next {
      right: 4px !important;
    }
  }
</style>

<div class="reviora-app-block" style="margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;">
  {% assign target_product_id = "all" %}
  {% if block.settings.product != blank and block.settings.product.handle != blank %}
    {% assign target_product_id = block.settings.product.handle %}
  {% elsif product != blank and product.handle != blank %}
    {% assign target_product_id = product.handle %}
  {% elsif block.settings.product != blank and block.settings.product.id != blank %}
    {% assign target_product_id = block.settings.product.id %}
  {% elsif product != blank and product.id != blank %}
    {% assign target_product_id = product.id %}
  {% endif %}

  <reviora-reviews-carousel
    type="cards"
    data-shop="{{ shop.myshopify_domain | default: shop.domain }}"
    data-product-id="{{ target_product_id }}"
    data-product-title="{{ product.title | default: 'Products' | escape }}"
    data-heading="{{ block.settings.heading | escape }}"
    data-subheading="{{ block.settings.subheading | escape }}"
    data-star-color="{{ block.settings.star_color | default: '#FFB800' }}"
    data-limit="{{ block.settings.limit | default: 8 }}"
    data-autoplay="{{ block.settings.autoplay | default: true }}"
  ></reviora-reviews-carousel>
</div>

{% schema %}
{
  "name": "Reviora Cards Carousel",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Our Customers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Read real, verified reviews from shoppers across our collection"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Filter by Specific Product",
      "info": "Leave blank to display top reviews from your entire store"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Rating Color",
      "default": "#FFB800"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 20,
      "step": 2,
      "label": "Max Reviews to Show",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Auto-scroll",
      "default": true
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top Margin",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom Margin",
      "default": 40
    }
  ]
}
{% endschema %}
